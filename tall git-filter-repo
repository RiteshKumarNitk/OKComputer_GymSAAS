[32m+[m[32m-- Create Expenses Table[m
[32m+[m[32mCREATE TABLE expenses ([m
[32m+[m[32m    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),[m
[32m+[m[32m    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,[m
[32m+[m[32m    title TEXT NOT NULL,[m
[32m+[m[32m    amount_cents INTEGER NOT NULL,[m
[32m+[m[32m    category TEXT NOT NULL CHECK (category IN ('rent', 'utilities', 'salary', 'maintenance', 'equipment', 'marketing', 'other')),[m
[32m+[m[32m    expense_date DATE NOT NULL DEFAULT CURRENT_DATE,[m
[32m+[m[32m    notes TEXT,[m
[32m+[m[32m    created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL,[m
[32m+[m[32m    updated_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Enable RLS[m
[32m+[m[32mALTER TABLE expenses ENABLE ROW LEVEL SECURITY;[m
[32m+[m
[32m+[m[32m-- Policies[m
[32m+[m[32mCREATE POLICY "Tenants can manage their own expenses" ON expenses[m
[32m+[m[32m    FOR ALL[m
[32m+[m[32m    USING ([m
[32m+[m[32m        tenant_id = (SELECT tenant_id FROM users_profile WHERE id = auth.uid())[m
[32m+[m[32m    );[m
[32m+[m
[32m+[m[32m-- Trigger for update_at[m
[32m+[m[32mCREATE TRIGGER update_expenses_modtime[m
[32m+[m[32m    BEFORE UPDATE ON expenses[m
[32m+[m[32m    FOR EACH ROW[m
[32m+[m[32m    EXECUTE FUNCTION update_modified_column();[m
