generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum UserRole {
  super_admin
  gym_owner
  manager
  trainer
  frontdesk
  member
}

enum MemberStatus {
  active
  inactive
  suspended
  expired
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProvider {
  stripe
  razorpay
  cash
}

enum SubscriptionStatus {
  active
  inactive
  cancelled
  past_due
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum ComplaintPriority {
  low
  medium
  high
  urgent
}

enum ExpenseCategory {
  rent
  utilities
  salary
  maintenance
  equipment
  marketing
  other
}

enum LeadStatus {
  new
  contacted
  trial
  converted
  lost
}

enum LockerStatus {
  available
  occupied
  maintenance
}

enum SaasInvoiceStatus {
  paid
  pending
  failed
  overdue
}

// =====================
// MODELS
// =====================

model Tenant {
  id                      String             @id @default(uuid())
  name                    String
  slug                    String             @unique
  ownerUserId             String?            // Link to User profile id
  ownerName               String?
  ownerEmail              String?
  ownerPhone              String?
  ownerPhotoUrl           String?
  address                 Json?              // { street, city, state, zip }
  phone                   String?
  email                   String?
  timezone                String?            @default("UTC")
  currency                String?            @default("USD")
  logoUrl                 String?
  businessType            String?
  gstNumber               String?
  panNumber               String?
  registeredAddress       String?
  billingCycle            String?            @default("monthly")
  paymentGatewayPreference String?
  invoicePrefix           String?
  subscriptionId          String?
  subscriptionStatus      SubscriptionStatus @default(inactive)
  subscriptionExpiresAt   DateTime?
  features                Json?              // ["members", "billing", "workouts", "diet-plans"]
  primaryColor            String?
  secondaryColor          String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  users                   UserProfile[]
  memberships             Membership[]
  members                 Member[]
  payments                Payment[]
  attendance             Attendance[]
  trainers                Trainer[]
  trainerSlots           TrainerSlot[]
  workouts                Workout[]
  dietPlans              DietPlan[]
  notifications           Notification[]
  auditLogs              AuditLog[]
  visitors                Visitor[]
  complaints              Complaint[]
  expenses                Expense[]
  leads                   Lead[]
  products                Product[]
  lockers                 Locker[]
  saasSubscriptions      SaasSubscription[]
  saasInvoices           SaasInvoice[]
  branches                Branch[]
  services                Service[]
  frontDesk              FrontDesk[]
  schedules               Schedule[]
  memberWorkouts         MemberWorkout[]
  memberDiets            MemberDiet[]
}

model UserProfile {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // For NextAuth credentials
  fullName      String?
  phone         String?
  avatarUrl     String?
  role          UserRole  @default(member)
  tenantId      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  member        Member?   @relation("UserToMember")
  trainer       Trainer?  @relation("UserToTrainer")
  frontDesk     FrontDesk? @relation("UserToFrontDesk")
  notifications Notification[]
  auditLogs     AuditLog[]
  createdWorkouts Workout[] @relation("CreatedWorkouts")
  createdDietPlans DietPlan[] @relation("CreatedDietPlans")
  assignedWorkouts MemberWorkout[] @relation("AssignedWorkouts")
  assignedDiets    MemberDiet[] @relation("AssignedDiets")
}

model Membership {
  id              String      @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  durationDays    Int
  priceCents      Int
  currency        String
  perks           Json?       @default("[]")
  type            String?     @default("recurring") // 'recurring', 'package', 'one_time'
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members         Member[]
  payments        Payment[]
}

model Member {
  id                String        @id @default(uuid())
  tenantId          String
  userId            String?       @unique
  memberCode        String
  fullName          String
  email             String?
  phone             String?
  dob               DateTime?
  gender            String?
  address           Json?
  emergencyContact  Json?
  joinedAt          DateTime      @default(now())
  currentPlanId     String?
  planStartedAt     DateTime?
  planExpiresAt     DateTime?
  status            MemberStatus  @default(active)
  notes             String?
  assignedTrainerId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              UserProfile?  @relation("UserToMember", fields: [userId], references: [id], onDelete: SetNull)
  currentPlan       Membership?   @relation(fields: [currentPlanId], references: [id])
  assignedTrainer   Trainer?      @relation(fields: [assignedTrainerId], references: [id])
  payments          Payment[]
  attendance       Attendance[]
  trainerSlots     TrainerSlot[] @relation("MemberTrainerSlots")
  workouts          MemberWorkout[]
  diets            MemberDiet[]
  complaints        Complaint[]
  lockers           Locker[]

  @@unique([tenantId, memberCode])
}

model Payment {
  id                    String          @id @default(uuid())
  tenantId              String
  memberId              String
  membershipId          String?
  amountCents           Int
  currency              String
  provider              PaymentProvider?
  providerPaymentId     String?
  status                PaymentStatus   @default(pending)
  paidAt                DateTime?
  metadata              Json?           @default("{}")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member                Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership            Membership?     @relation(fields: [membershipId], references: [id])
}

model Attendance {
  id            String    @id @default(uuid())
  tenantId      String
  memberId      String
  checkinAt     DateTime  @default(now())
  checkoutAt    DateTime?
  deviceInfo    Json?     @default("{}")
  createdAt     DateTime  @default(now())

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Trainer {
  id                String        @id @default(uuid())
  tenantId          String
  userId            String?       @unique
  fullName          String
  email             String?
  phone             String?
  bio               String?
  specialties       String[]      @default([])
  hourlyRateCents   Int?
  isActive          Boolean       @default(true)
  avatarUrl         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              UserProfile?  @relation("UserToTrainer", fields: [userId], references: [id], onDelete: SetNull)
  slots             TrainerSlot[]
  members           Member[]
  schedules         Schedule[]
}

model TrainerSlot {
  id                String    @id @default(uuid())
  trainerId         String
  tenantId          String
  dayOfWeek         Int       // 0=Sunday, 1=Monday, etc.
  startTime         String    // Used string instead of Time for compatibility or DateTime
  endTime           String
  isRecurring       Boolean   @default(true)
  isBooked          Boolean   @default(false)
  bookedByMemberId  String?
  bookedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  trainer           Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookedBy          Member?   @relation("MemberTrainerSlots", fields: [bookedByMemberId], references: [id])
}

model Schedule {
  id                String    @id @default(uuid())
  tenantId          String
  serviceId         String
  trainerId         String?
  dayOfWeek         Int       // 0=Sunday, 6=Saturday
  startTime         String
  durationMinutes   Int       @default(60)
  maxCapacity       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service           Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  trainer           Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
}

model Workout {
  id                        String    @id @default(uuid())
  tenantId                  String
  name                      String
  description               String?
  exercises                 Json      @default("[]")
  createdBy                 String?
  isPublic                  Boolean   @default(false)
  difficulty                String?
  estimatedDurationMinutes Int?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Relations
  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator                   UserProfile? @relation("CreatedWorkouts", fields: [createdBy], references: [id])
  memberAssignments         MemberWorkout[]
}

model DietPlan {
  id                    String    @id @default(uuid())
  tenantId              String
  name                  String
  description           String?
  meals                 Json      @default("[]")
  createdBy             String?
  isPublic              Boolean   @default(false)
  targetCalories        Int?
  dietaryRestrictions  String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator               UserProfile? @relation("CreatedDietPlans", fields: [createdBy], references: [id])
  memberAssignments     MemberDiet[]
}

model MemberWorkout {
  id            String    @id @default(uuid())
  tenantId      String
  memberId      String
  workoutId     String
  assignedBy    String?
  assignedAt    DateTime  @default(now())
  completedAt   DateTime?
  notes         String?
  progress      Json?     @default("{}")

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workout       Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  assigner      UserProfile? @relation("AssignedWorkouts", fields: [assignedBy], references: [id])
}

model MemberDiet {
  id            String    @id @default(uuid())
  tenantId      String
  memberId      String
  dietPlanId    String
  assignedBy    String?
  assignedAt    DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dietPlan      DietPlan  @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  assigner      UserProfile? @relation("AssignedDiets", fields: [assignedBy], references: [id])
}

model Notification {
  id                String    @id @default(uuid())
  tenantId          String
  userId            String?
  notificationType  String
  title             String
  message           String
  data              Json?     @default("{}")
  isRead            Boolean   @default(false)
  createdAt         DateTime  @default(now())

  // Relations
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              UserProfile? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String    @id @default(uuid())
  tenantId      String?
  userId        String?
  action        String
  resourceType  String?
  resourceId    String?
  changes       Json?     @default("{}")
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  // Relations
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  user          UserProfile? @relation(fields: [userId], references: [id])
}

model Visitor {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  phone         String?
  visitPurpose  String?   // 'Inquiry', 'Guest', 'Vendor'
  visitTime     DateTime  @default(now())
  outTime       DateTime?
  createdAt     DateTime  @default(now())

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Complaint {
  id            String            @id @default(uuid())
  tenantId      String
  memberId      String?
  title         String
  description   String?
  status        ComplaintStatus   @default(open)
  priority      ComplaintPriority @default(medium)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model Expense {
  id            String          @id @default(uuid())
  tenantId      String
  title         String
  amountCents   Int
  category      ExpenseCategory
  expenseDate   DateTime        @default(now())
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Lead {
  id            String      @id @default(uuid())
  tenantId      String
  fullName      String
  email         String?
  phone         String
  status        LeadStatus  @default(new)
  source        String?     @default("walk-in")
  notes         String?
  assignedTo    String?     // Links to UserProfile.id
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  priceCents    Int
  stockQuantity Int?      @default(0)
  category      String?
  imageUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Locker {
  id                  String        @id @default(uuid())
  tenantId            String
  lockerNumber        String
  status              LockerStatus  @default(available)
  assignedToMemberId  String?
  expiresAt           DateTime?
  createdAt           DateTime      @default(now())

  // Relations
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member              Member?       @relation(fields: [assignedToMemberId], references: [id], onDelete: SetNull)
}

model SaasPlan {
  id            String    @id @default(uuid())
  name          String
  description   String?
  priceInr      Decimal   @db.Decimal
  durationDays  Int?      @default(365)
  features      Json      @default("[]")
  isActive      Boolean?  @default(true)
  createdAt     DateTime? @default(now())

  // Relations
  subscriptions SaasSubscription[]
}

model SaasSubscription {
  id            String    @id @default(uuid())
  tenantId      String
  planId        String?
  startDate     DateTime? @default(now())
  endDate       DateTime?
  pricePaidInr  Decimal?  @db.Decimal
  status        String?   @default("active") // 'active', 'expired', 'cancelled', 'trial'
  createdAt     DateTime? @default(now())

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          SaasPlan? @relation(fields: [planId], references: [id])
  invoices      SaasInvoice[]
}

model SaasInvoice {
  id              String            @id @default(uuid())
  tenantId        String
  subscriptionId  String?
  invoiceNumber   String?           @unique
  amountInr       Decimal?          @db.Decimal
  status          SaasInvoiceStatus @default(pending)
  paymentDate     DateTime?
  createdAt       DateTime?         @default(now())

  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  subscription    SaasSubscription? @relation(fields: [subscriptionId], references: [id])
}

model Branch {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  managerId String?   // Links to UserProfile.id
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Service {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  type        String?   @default("class") // 'class', 'facility', 'training'
  capacity    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules   Schedule[]
}

model FrontDesk {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String?   @unique
  fullName  String
  email     String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      UserProfile? @relation("UserToFrontDesk", fields: [userId], references: [id], onDelete: SetNull)
}
