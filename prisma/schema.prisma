generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum UserRole {
  super_admin
  gym_owner
  manager
  trainer
  frontdesk
  member
}

enum TenantStatus {
  active
  suspended
  cancelled
}

enum MemberStatus {
  active
  inactive
  suspended
  expired
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProvider {
  stripe
  razorpay
  cash
}

enum SubscriptionStatus {
  active
  inactive
  cancelled
  past_due
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum ComplaintPriority {
  low
  medium
  high
  urgent
}

enum ExpenseCategory {
  rent
  utilities
  salary
  maintenance
  equipment
  marketing
  other
}

enum LeadStatus {
  new
  contacted
  trial
  converted
  lost
}

enum LockerStatus {
  available
  occupied
  maintenance
}

enum SaasInvoiceStatus {
  paid
  pending
  failed
  overdue
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum BloodGroup {
  A_pos
  A_neg
  B_pos
  B_neg
  AB_pos
  AB_neg
  O_pos
  O_neg
}

enum FitnessGoal {
  weight_loss
  muscle_gain
  endurance
  flexibility
  general_fitness
  sports_performance
  rehabilitation
}

enum StaffStatus {
  active
  on_leave
  terminated
  resigned
  probation
}

enum StaffShift {
  morning
  evening
  both
}

enum LeaveType {
  casual
  sick
  earned
  unpaid
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum MessageChannel {
  sms
  whatsapp
  email
  in_app
  push
}

enum MessageStatus {
  pending
  sent
  delivered
  failed
  read
}

enum CampaignStatus {
  draft
  scheduled
  running
  completed
  cancelled
}

enum RazorpayWebhookEvent {
  payment_captured
  payment_failed
  refund_processed
  subscription_activated
  subscription_cancelled
  subscription_charged
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
  void
}

enum BodyMeasurementType {
  weight_kg
  height_cm
  chest_cm
  waist_cm
  hips_cm
  bicep_cm
  thigh_cm
  body_fat_percent
  bmi
}

enum LeadPriority {
  hot
  warm
  cold
}

enum FollowUpType {
  enquiry
  balance
  feedback
  renewal
}

enum FollowUpStatus {
  pending
  completed
  cancelled
}

// =====================
// MODELS
// =====================

model Tenant {
  id                       String             @id @default(uuid())
  name                     String
  slug                     String             @unique
  ownerUserId              String? // Link to User profile id
  ownerName                String?
  ownerEmail               String?
  ownerPhone               String?
  ownerPhotoUrl            String?
  address                  Json? // { street, city, state, zip }
  phone                    String?
  email                    String?
  timezone                 String?            @default("UTC")
  currency                 String?            @default("INR")
  logoUrl                  String?
  businessType             String?
  status                   TenantStatus       @default(active)
  gstNumber                String?
  panNumber                String?
  registeredAddress        String?
  billingCycle             String?            @default("monthly")
  paymentGatewayPreference String?
  invoicePrefix            String?
  subscriptionId           String?
  subscriptionStatus       SubscriptionStatus @default(inactive)
  subscriptionExpiresAt    DateTime?
  features                 Json? // ["members", "billing", "workouts", "diet-plans"]
  primaryColor             String?
  secondaryColor           String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  // Relations
  users               UserProfile[]
  memberships         Membership[]
  members             Member[]
  payments            Payment[]
  attendance          Attendance[]
  trainers            Trainer[]
  trainerSlots        TrainerSlot[]
  workouts            Workout[]
  workoutTemplates    WorkoutTemplate[]
  dietPlans           DietPlan[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  visitors            Visitor[]
  complaints          Complaint[]
  expenses            Expense[]
  leads               Lead[]
  products            Product[]
  lockers             Locker[]
  saasSubscriptions   SaasSubscription[]
  saasInvoices        SaasInvoice[]
  branches            Branch[]
  services            Service[]
  frontDesk           FrontDesk[]
  schedules           Schedule[]
  memberWorkouts      MemberWorkout[]
  memberDiets         MemberDiet[]
  membershipHistories MembershipHistory[]
  // Staff & HR
  staffProfiles       StaffProfile[]
  staffAttendance     StaffAttendance[]
  staffLeaves         StaffLeave[]
  salarySlips         SalarySlip[]
  // Communications
  messages            Message[]
  campaigns           Campaign[]
  messageTemplates    MessageTemplate[]
  // Payments & Invoicing
  razorpayOrders      RazorpayOrder[]
  razorpayWebhooks    RazorpayWebhookLog[]
  invoices            Invoice[]
  discounts           Discount[]
  followUps           FollowUp[]
  dailyWorkoutPlans   DailyWorkoutPlan[]
}

model UserProfile {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String? // bcrypt hash — never store plaintext. Remove this field entirely if using Supabase Auth.
  fullName     String?
  phone        String?
  avatarUrl    String?
  role         UserRole @default(member)
  tenantId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenant           Tenant?         @relation(fields: [tenantId], references: [id])
  member           Member?         @relation("UserToMember")
  trainer          Trainer?        @relation("UserToTrainer")
  frontDesk        FrontDesk?      @relation("UserToFrontDesk")
  notifications    Notification[]
  auditLogs        AuditLog[]
  createdWorkouts  Workout[]       @relation("CreatedWorkouts")
  createdDietPlans DietPlan[]      @relation("CreatedDietPlans")
  assignedFollowUps FollowUp[]
  assignedWorkouts MemberWorkout[] @relation("AssignedWorkouts")
  assignedDiets    MemberDiet[]    @relation("AssignedDiets")
  staffProfile     StaffProfile?

  @@index([phone])
}

model Membership {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  durationDays Int
  priceCents   Int
  currency     String
  perks        Json?    @default("[]")
  type         String?  @default("recurring") // 'recurring', 'package', 'one_time'
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members           Member[]
  payments          Payment[]
  membershipHistory MembershipHistory[]
}

model Member {
  id                String       @id @default(uuid())
  tenantId          String
  userId            String?      @unique
  memberCode        String
  fullName          String
  email             String?
  phone             String?
  dob               DateTime?
  gender            Gender?
  address           Json?
  emergencyContact  Json?
  joinedAt          DateTime     @default(now())
  currentPlanId     String?
  planStartedAt     DateTime?
  planExpiresAt     DateTime?
  status            MemberStatus @default(active)
  notes             String?
  assignedTrainerId String?
  avatarUrl         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              UserProfile?         @relation("UserToMember", fields: [userId], references: [id], onDelete: SetNull)
  currentPlan       Membership?          @relation(fields: [currentPlanId], references: [id])
  assignedTrainer   Trainer?             @relation(fields: [assignedTrainerId], references: [id])
  payments          Payment[]
  attendance        Attendance[]
  trainerSlots      TrainerSlot[]        @relation("MemberTrainerSlots")
  workouts          MemberWorkout[]
  diets             MemberDiet[]
  complaints        Complaint[]
  lockers           Locker[]
  membershipHistory MembershipHistory[]
  invoices          Invoice[]
  // Health & Fitness
  healthProfile     MemberHealthProfile?
  measurements      BodyMeasurement[]
  fitnessStats      MemberFitnessStats?
  followUps         FollowUp[]
  dailyWorkoutPlans DailyWorkoutPlan[]

  @@unique([tenantId, memberCode])
}

model Payment {
  id                String           @id @default(uuid())
  tenantId          String
  memberId          String
  membershipId      String?
  razorpayOrderId   String?          @unique // links to RazorpayOrder on capture
  amountCents       Int
  currency          String
  provider          PaymentProvider?
  providerPaymentId String?
  status            PaymentStatus    @default(pending)
  paidAt            DateTime?
  metadata          Json?            @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member            Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership        Membership?         @relation(fields: [membershipId], references: [id])
  razorpayOrder     RazorpayOrder?      @relation(fields: [razorpayOrderId], references: [razorpayOrderId])
  membershipHistory MembershipHistory[]
  invoice           Invoice?
}

model Attendance {
  id         String    @id @default(uuid())
  tenantId   String
  memberId   String
  checkinAt  DateTime  @default(now())
  checkoutAt DateTime?
  deviceInfo Json?     @default("{}")
  createdAt  DateTime  @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Trainer {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String?  @unique
  fullName        String
  email           String?
  phone           String?
  bio             String?
  specialties     String[] @default([])
  hourlyRateCents Int?
  isActive        Boolean  @default(true)
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      UserProfile?  @relation("UserToTrainer", fields: [userId], references: [id], onDelete: SetNull)
  slots             TrainerSlot[]
  members           Member[]
  schedules         Schedule[]
  dailyWorkoutPlans DailyWorkoutPlan[]
}

model TrainerSlot {
  id               String    @id @default(uuid())
  trainerId        String
  tenantId         String
  dayOfWeek        Int // 0=Sunday, 1=Monday, etc.
  startTime        String // Used string instead of Time for compatibility or DateTime
  endTime          String
  isRecurring      Boolean   @default(true)
  isBooked         Boolean   @default(false)
  bookedByMemberId String?
  bookedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  trainer  Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookedBy Member? @relation("MemberTrainerSlots", fields: [bookedByMemberId], references: [id])
}

model Schedule {
  id              String   @id @default(uuid())
  tenantId        String
  serviceId       String
  trainerId       String?
  dayOfWeek       Int // 0=Sunday, 6=Saturday
  startTime       String
  durationMinutes Int      @default(60)
  maxCapacity     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
}

model Workout {
  id                       String   @id @default(uuid())
  tenantId                 String
  name                     String
  description              String?
  exercises                Json     @default("[]")
  createdBy                String?
  isPublic                 Boolean  @default(false)
  difficulty               String?
  estimatedDurationMinutes Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator           UserProfile?    @relation("CreatedWorkouts", fields: [createdBy], references: [id])
  memberAssignments MemberWorkout[]
}

model DietPlan {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  description         String?
  meals               Json     @default("[]")
  createdBy           String?
  isPublic            Boolean  @default(false)
  targetCalories      Int?
  dietaryRestrictions String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator           UserProfile? @relation("CreatedDietPlans", fields: [createdBy], references: [id])
  memberAssignments MemberDiet[]
}

model MemberWorkout {
  id          String    @id @default(uuid())
  tenantId    String
  memberId    String
  workoutId   String
  assignedBy  String?
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  notes       String?
  progress    Json?     @default("{}")

  // Relations
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  assigner UserProfile? @relation("AssignedWorkouts", fields: [assignedBy], references: [id])
}

model MemberDiet {
  id          String    @id @default(uuid())
  tenantId    String
  memberId    String
  dietPlanId  String
  assignedBy  String?
  assignedAt  DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?

  // Relations
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dietPlan DietPlan     @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  assigner UserProfile? @relation("AssignedDiets", fields: [assignedBy], references: [id])
}

model Notification {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String?
  notificationType String
  title            String
  message          String
  data             Json?    @default("{}")
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Relations
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   UserProfile? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  changes      Json?    @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  // Relations
  tenant Tenant?      @relation(fields: [tenantId], references: [id])
  user   UserProfile? @relation(fields: [userId], references: [id])
}

model Visitor {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  phone        String?
  visitPurpose String? // 'Inquiry', 'Guest', 'Vendor'
  visitTime    DateTime  @default(now())
  outTime      DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String            @id @default(uuid())
  tenantId    String
  memberId    String?
  title       String
  description String?
  status      ComplaintStatus   @default(open)
  priority    ComplaintPriority @default(medium)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model Expense {
  id          String          @id @default(uuid())
  tenantId    String
  title       String
  amountCents Int
  category    ExpenseCategory
  expenseDate DateTime        @default(now())
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Lead {
  id         String       @id @default(uuid())
  tenantId   String
  firstName  String?
  lastName   String?
  fullName   String?
  email      String?
  phone      String
  gender     Gender?
  priority   LeadPriority @default(warm)
  status     LeadStatus   @default(new)
  source     String?      @default("walk-in")
  budget     Float?
  address    String?
  notes      String?
  services   Json?        @default("[]")
  assignedTo String? // Links to UserProfile.id
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  followUps FollowUp[]
}

model FollowUp {
  id           String         @id @default(uuid())
  tenantId     String
  leadId       String?
  memberId     String?
  type         FollowUpType   @default(enquiry)
  status       FollowUpStatus @default(pending)
  priority     LeadPriority?  @default(warm)
  followUpDate DateTime
  notes        String?
  todo         String?
  assignedTo   String? // Links to UserProfile.id
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  member   Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignee UserProfile? @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  priceCents    Int
  stockQuantity Int?     @default(0)
  category      String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Locker {
  id                 String       @id @default(uuid())
  tenantId           String
  lockerNumber       String
  status             LockerStatus @default(available)
  assignedToMemberId String?
  expiresAt          DateTime?
  createdAt          DateTime     @default(now())

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [assignedToMemberId], references: [id], onDelete: SetNull)
}

model SaasPlan {
  id           String    @id @default(uuid())
  name         String
  description  String?
  pricePaise   Int // Price in paise (1 INR = 100 paise) — consistent with priceCents convention
  durationDays Int?      @default(365)
  features     Json      @default("[]")
  isActive     Boolean?  @default(true)
  createdAt    DateTime? @default(now())

  // Relations
  subscriptions SaasSubscription[]
}

model SaasSubscription {
  id             String             @id @default(uuid())
  tenantId       String
  planId         String?
  startDate      DateTime?          @default(now())
  endDate        DateTime?
  pricePaidPaise Int? // Amount paid in paise — consistent with priceCents convention
  status         SubscriptionStatus @default(active)
  createdAt      DateTime?          @default(now())

  // Relations
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SaasPlan?     @relation(fields: [planId], references: [id])
  invoices SaasInvoice[]
}

model SaasInvoice {
  id             String            @id @default(uuid())
  tenantId       String
  subscriptionId String?
  invoiceNumber  String?           @unique
  amountPaise    Int? // Amount in paise — consistent with priceCents convention
  status         SaasInvoiceStatus @default(pending)
  paymentDate    DateTime?
  createdAt      DateTime?         @default(now())

  // Relations
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  subscription SaasSubscription? @relation(fields: [subscriptionId], references: [id])
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  managerId String? // Links to UserProfile.id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  type        String?  @default("class") // 'class', 'facility', 'training'
  capacity    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules Schedule[]
}

model FrontDesk {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?  @unique
  fullName  String
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   UserProfile? @relation("UserToFrontDesk", fields: [userId], references: [id], onDelete: SetNull)
}

// =====================
// MEMBERSHIP HISTORY
// =====================

// Tracks every plan a member has ever held.
// Created on every new enrollment or renewal — never overwrite Member.currentPlanId without logging here first.
model MembershipHistory {
  id           String    @id @default(uuid())
  tenantId     String
  memberId     String
  membershipId String // Which plan was held
  paymentId    String? // The payment that triggered this enrollment (nullable for manual/free entries)
  startedAt    DateTime // When this plan period began
  expiresAt    DateTime // When this plan period ends/ended
  endedAt      DateTime? // Set when manually terminated before expiry
  notes        String? // e.g. "Renewal", "Upgrade from Basic", "Complimentary"
  createdAt    DateTime  @default(now())

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])
}

// =====================
// MEMBER HEALTH & FITNESS
// =====================

model MemberHealthProfile {
  id                String       @id @default(uuid())
  tenantId          String
  memberId          String       @unique
  bloodGroup        BloodGroup?
  height            Float? // cm
  weight            Float? // kg at enrollment
  bmi               Float? // calculated on save
  fitnessGoal       FitnessGoal?
  activityLevel     String? // 'sedentary', 'light', 'moderate', 'active', 'very_active'
  medicalConditions String[]     @default([])
  allergies         String[]     @default([])
  medications       String[]     @default([])
  injuryHistory     Json?        @default("[]") // [{ part, description, year }]
  emergencyContact  Json?
  doctorClearance   Boolean      @default(false)
  doctorName        String?
  doctorPhone       String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  member       Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  measurements BodyMeasurement[]
}

model BodyMeasurement {
  id              String              @id @default(uuid())
  tenantId        String
  memberId        String
  healthProfileId String
  type            BodyMeasurementType
  value           Float
  unit            String // 'kg', 'cm', '%'
  recordedAt      DateTime            @default(now())
  recordedBy      String? // UserProfile.id
  notes           String?
  createdAt       DateTime            @default(now())

  // Relations
  member        Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  healthProfile MemberHealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)
}

model MemberFitnessStats {
  id                     String    @id @default(uuid())
  tenantId               String
  memberId               String    @unique
  totalCheckIns          Int       @default(0)
  currentStreak          Int       @default(0)
  longestStreak          Int       @default(0)
  lastCheckInDate        DateTime?
  weeklyGoal             Int?      @default(3)
  totalWorkoutsCompleted Int       @default(0)
  updatedAt              DateTime  @updatedAt

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// =====================
// STAFF & HR MANAGEMENT
// =====================

model StaffProfile {
  id                String      @id @default(uuid())
  tenantId          String
  userId            String      @unique
  employeeCode      String
  department        String?
  designation       String?
  joiningDate       DateTime    @default(now())
  resignationDate   DateTime?
  shift             StaffShift  @default(morning)
  status            StaffStatus @default(active)
  salaryPerMonth    Int? // paise
  bankAccountName   String?
  bankAccountNumber String?
  bankIFSC          String?
  panNumber         String?
  aadhaarNumber     String? // masked — last 4 digits only in display
  address           Json?
  emergencyContact  Json?
  documents         Json?       @default("[]") // [{ type, url, name }]
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        UserProfile       @relation(fields: [userId], references: [id])
  attendance  StaffAttendance[]
  leaves      StaffLeave[]
  salarySlips SalarySlip[]

  @@unique([tenantId, employeeCode])
}

model StaffAttendance {
  id          String    @id @default(uuid())
  tenantId    String
  staffId     String
  date        DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  hoursWorked Float?
  isPresent   Boolean   @default(true)
  isHoliday   Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())

  // Relations
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

model StaffLeave {
  id         String      @id @default(uuid())
  tenantId   String
  staffId    String
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  totalDays  Int
  reason     String?
  status     LeaveStatus @default(pending)
  approvedBy String? // UserProfile.id
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model SalarySlip {
  id            String    @id @default(uuid())
  tenantId      String
  staffId       String
  month         Int
  year          Int
  basicSalary   Int // paise
  deductions    Int       @default(0)
  bonuses       Int       @default(0)
  netSalary     Int // paise
  daysWorked    Int?
  daysAbsent    Int?
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime  @default(now())

  // Relations
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, month, year])
}

// =====================
// COMMUNICATIONS & MESSAGING
// =====================

model Message {
  id            String         @id @default(uuid())
  tenantId      String
  memberId      String?
  channel       MessageChannel
  recipient     String
  subject       String?
  body          String
  status        MessageStatus  @default(pending)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  provider      String?
  providerMsgId String?
  campaignId    String?
  metadata      Json?          @default("{}")
  createdAt     DateTime       @default(now())

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])
}

model Campaign {
  id              String         @id @default(uuid())
  tenantId        String
  name            String
  channel         MessageChannel
  subject         String?
  body            String // supports {{member_name}}, {{expiry_date}}
  status          CampaignStatus @default(draft)
  targetAudience  Json?
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int            @default(0)
  totalSent       Int            @default(0)
  totalFailed     Int            @default(0)
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages Message[]
}

model MessageTemplate {
  id         String         @id @default(uuid())
  tenantId   String
  name       String
  triggerKey String? // 'membership_expiry_7d', 'new_member', 'payment_done'
  channel    MessageChannel
  subject    String?
  body       String
  isActive   Boolean        @default(true)
  isSystem   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, triggerKey])
}

// =====================
// PAYMENTS & INVOICING (RAZORPAY)
// =====================

model RazorpayOrder {
  id              String    @id @default(uuid())
  tenantId        String
  memberId        String
  membershipId    String?
  razorpayOrderId String    @unique
  amountPaise     Int
  currency        String    @default("INR")
  status          String    @default("created") // 'created', 'attempted', 'paid'
  attempts        Int       @default(0)
  receipt         String?
  notes           Json?     @default("{}")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEvents RazorpayWebhookLog[]
  payment       Payment?
}

model RazorpayWebhookLog {
  id              String               @id @default(uuid())
  tenantId        String
  orderId         String?
  event           RazorpayWebhookEvent
  razorpayEventId String               @unique
  payload         Json
  processed       Boolean              @default(false)
  processedAt     DateTime?
  error           String?
  createdAt       DateTime             @default(now())

  // Relations
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  RazorpayOrder? @relation(fields: [orderId], references: [id])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  memberId       String
  paymentId      String?       @unique
  invoiceNumber  String        @unique
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime?
  status         InvoiceStatus @default(draft)
  subtotalPaise  Int
  discountPaise  Int           @default(0)
  taxPercent     Float         @default(18)
  taxPaise       Int           @default(0)
  totalPaise     Int
  currency       String        @default("INR")
  notes          String?
  lineItems      Json          @default("[]")
  billingAddress Json?
  gymDetails     Json?
  pdfUrl         String?
  sentAt         DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])
}

model Discount {
  id              String    @id @default(uuid())
  tenantId        String
  code            String
  description     String?
  discountPercent Float?
  discountPaise   Int?
  maxUsage        Int?
  usedCount       Int       @default(0)
  minOrderPaise   Int?
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

// =====================
// WORKOUT TEMPLATES (Weekly Plans)
// =====================

model WorkoutTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name       String
  description String?
  days       Int      @default(7) // 6 or 7 day plan
  exercises  Json     @default("[]") // Array of {day: "Monday", exercises: [...]}
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

// =====================
// DAILY EXERCISE PLANS
// =====================

model DailyWorkoutPlan {
  id          String   @id @default(uuid())
  tenantId    String
  trainerId   String?  // Nullable if system auto-assigned
  memberId    String
  date        DateTime @db.Date  // Target date for the workout
  day         String   // e.g., "Monday"
  planType    String   @default("default") // "default" or "custom"
  
  // Array of exercise objects (status, sets, reps, completedAt)
  exercises   Json     @default("[]") 
  
  // Computed progress cache
  progress    Json     @default("{\"totalExercises\": 0, \"completed\": 0, \"percentage\": 0}")
  status      String   @default("pending") // "pending", "in_progress", "completed", "skipped"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer     Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([tenantId, memberId, date])
}
