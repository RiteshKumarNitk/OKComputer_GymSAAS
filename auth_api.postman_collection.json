		"name": "Gym SaaS WhatsApp Auth",
		"description": "API collection for WhatsApp OTP Authentication flow.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Send OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phone\": \"919876543210\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/send-otp",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"send-otp"
					]
				}
			},
			"response": []
		},
		{
			"name": "Verify OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phone\": \"919876543210\",\n    \"otp\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/verify-otp",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"verify-otp"
					]
				}
			},
			"response": []
		}
